# =====================================================================
# SOS Car - configuracao local
#
# Este arquivo NAO deve ser enviado ao GitHub (ja esta no .gitignore).
# Depois de editar, reinicie o servidor (Ctrl+C e "npm start" de novo).
# Regra de formato: uma variavel por linha, sem espacos ao redor do "=".
# Se um valor tiver "#", espacos ou aspas, coloque-o entre aspas duplas.
# =====================================================================


# ---------------------------------------------------------------------
# BANCO DE DADOS MySQL (online)
# Preencha com os dados do painel da hospedagem (na Hostinger:
# Bancos de dados > Gerenciamento > "MySQL remoto").
#
# - DB_HOST: use o endereco PUBLICO do servidor MySQL. Enderecos que
#   comecam com 10., 172.16 a 172.31 ou 192.168 sao internos da
#   hospedagem e nao funcionam a partir do seu computador.
# - Na hospedagem, autorize o IP do seu computador em "MySQL remoto";
#   sem isso a conexao e recusada.
# - Se ficar em branco, o sistema tenta um MySQL local (127.0.0.1) e,
#   se ele nao existir, guarda tudo so em memoria (perde ao reiniciar).
# ---------------------------------------------------------------------
DB_HOST=212.85.3.212
DB_PORT=3306
DB_NAME=u815496249_soscar
DB_USER=u815496249_soscar
DB_PASSWORD=Sda481@sud


# ---------------------------------------------------------------------
# ADMINISTRADOR (painel administrativo)
# Sem estas duas linhas o login de admin e admin@soscar.com / admin123,
# que qualquer pessoa conhece. Defina as suas antes de publicar o sistema.
# Para tirar o "#" da frente, apague so o "#".
# ---------------------------------------------------------------------
ADMIN_EMAIL=admin@admin
ADMIN_SENHA=admin


# ---------------------------------------------------------------------
# E-MAIL (recuperacao de senha) - opcional
# Sem isto, o link de redefinicao aparece apenas no console do servidor
# (procure por "[e-mail]" no terminal).
# APP_URL e o endereco publico do site, usado para montar o link.
# Suporta: gmail e hotmail (outlook)
# Troque SMTP_PROVIDER para "gmail" ou "hotmail" conforme a conta que
# estiver sendo usada. Se o provedor exigir App Password, informe a senha
# de aplicativo gerada na conta Microsoft/Gmail.
# ---------------------------------------------------------------------
SMTP_PROVIDER=hotmail
SMTP_HOST_GMAIL=smtp.gmail.com
SMTP_PORT_GMAIL=587
SMTP_USER_GMAIL=seuemail@gmail.com
SMTP_PASS_GMAIL=sua_app_password_gmail
SMTP_FROM_GMAIL=seuemail@gmail.com

SMTP_HOST_HOTMAIL=smtp.office365.com
SMTP_PORT_HOTMAIL=587
SMTP_USER_HOTMAIL=soscar2026@hotmail.com
SMTP_PASS_HOTMAIL=Etec2026@
SMTP_FROM_HOTMAIL=soscar2026@hotmail.com

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=soscar2026@hotmail.com
SMTP_PASS=Etec2026@
SMTP_FROM=soscar2026@hotmail.com
APP_URL=https://10.67.23.44:3000
RESET_TOKEN_OVERRIDE=71c396485cf3af5ddcc0a8f98ad5ffd7



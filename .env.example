# Copie este arquivo para ".env" (ou defina as mesmas variáveis no seu
# ambiente/serviço de hospedagem) e preencha os valores. Nenhuma delas é
# obrigatória para rodar o projeto localmente — sem configurar nada, o
# servidor sobe com valores padrão (alguns inseguros, só para demonstração).

# --- Banco de dados MySQL (server/db.js) ---
# Sem estas variáveis, o projeto usa um banco remoto já configurado no
# código (ver server/db.js) ou, se ele estiver inacessível, guarda os
# dados só em memória (modo fallback).
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Conta de administrador (server/server.js) ---
# Sem estas variáveis, o painel admin usa admin@soscar.com / admin123 —
# troque antes de usar em qualquer ambiente que não seja só para teste local.
ADMIN_EMAIL=
ADMIN_SENHA=

# --- Envio de e-mail / recuperação de senha (server/email.js) ---
# Sem SMTP_HOST/SMTP_USER/SMTP_PASS, o link de redefinição de senha não é
# enviado por e-mail de verdade — fica só registrado no console do
# servidor (útil para testar o fluxo sem precisar de um serviço de e-mail).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# URL pública onde o app está publicado, usada para montar o link de
# redefinição de senha enviado por e-mail (ex.: https://soscar.com.br).
# Sem esta variável, assume http://localhost:3000.
APP_URL=

# Porta e host onde o servidor escuta (opcionais).
PORT=3000
HOST=0.0.0.0

# --- OpenStreetMap/Nominatim ---
# Identificação enviada ao serviço público de geocodificação. Em produção,
# informe um contato real da aplicação.
OSM_USER_AGENT=SOS-Car/1.0 (contato: soscar2026@hotmail.com)
